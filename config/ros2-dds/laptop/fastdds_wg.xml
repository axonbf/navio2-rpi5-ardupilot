<?xml version="1.0" encoding="UTF-8" ?>
<!-- Laptop-side Fast-DDS profile: additive. Keeps default transports and lists BOTH the
     standard SPDP multicast locator (239.255.0.1 -> local terminal-to-terminal discovery)
     AND the Pi as a unicast initial peer over wg0 (WireGuard does not forward multicast).
     initialPeersList REPLACES Fast-DDS's default peers, so multicast must be listed
     explicitly or local discovery is lost. Deploy to ~/fastdds_wg.xml; sourced by
     ros2_boat.sh. -->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <participant profile_name="laptop_wg" is_default_profile="true">
      <rtps>
        <builtin>
          <initialPeersList>
            <locator>
              <udpv4>
                <address>239.255.0.1</address>
              </udpv4>
            </locator>
            <locator>
              <udpv4>
                <address>10.0.0.5</address>
              </udpv4>
            </locator>
          </initialPeersList>
        </builtin>
      </rtps>
    </participant>
  </profiles>
</dds>